{
  "name": "parquet4abap",
  "private": true,
  "description": "Apache Parquet reader and writer in native ABAP",
  "scripts": {
    "lint": "abaplint",
    "transpile": "node tools/clean-output.mjs && abap_transpile",
    "unit": "npm run transpile && node output/index.mjs",
    "test": "npm run lint && npm run unit",
    "osg": "node tools/run-osg.mjs",
    "osg:go": "node tools/run-osg.mjs --path go",
    "osg:js": "node tools/run-osg.mjs --path js"
  },
  "devDependencies": {
    "@abaplint/cli": "^2.120.113",
    "@abaplint/runtime": "^2.14.34",
    "@abaplint/transpiler-cli": "^2.14.34"
  }
}
